
@"@voxgig/model/model/sys.aontu"


main: @"main.aontu"


main: msg: {
  aim: foo: color: red: {}
  aim: bar: element: hydrogen: {}
}


main: srv: mercury: {
  in: aim: foo: {}
  env: lambda: {
    active: true
    handler: {
      path: prefix: '/src/handlers/'
    }
  }
  api: web: {
    path: {
      prefix: '/api/'
      area: 'general/'
      suffix: ''
    }
    cors: active: true
  }
}


main: srv: venus: {
  in: aim: bar: {}
}


main: conf: core: {
  name: 's01'
  short: 's01'
  token: 's01-auth'
}
